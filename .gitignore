node_modules/
*.tgz
*.log

# WSL debris beside downloaded files. A test asserts these never reach the
# payload; ignoring them keeps them out of commits in the first place.
*:Zone.Identifier

# Execution telemetry lives outside the repository (RFC D-007). This is a
# belt-and-braces entry in case a stateDir is ever configured inside a project.
.adp/

# Proof the example produces when it is verified. Regenerated on every run and
# stamped with a git revision, so a committed copy would be stale immediately.
.exemplo/.spec/verification/*.json

# Scratch space for specifications handed to an agent mid-session. Consumed and
# deleted once read, so nothing here is ever meant to outlive the conversation.
.doc/
