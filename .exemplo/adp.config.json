{
  "testCommand": "node --test --test-reporter=tap \"test/*.test.js\"",
  "reporter": "tap",
  "testGlobs": [
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*"
  ],
  "srcGlobs": [
    "src/**"
  ],
  "delivery": "local-only",
  "parallel": {
    "maxParallel": 3
  },
  "metrics": {
    "historyPath": ".spec/metrics/hours-history.jsonl"
  }
}
